{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "IKEMEN Constants",
  "scopeName": "source.ikemen-cns",
  "patterns": [
    { "include": "#comments" },
    { "include": "#sections" },
    { "include": "#commands" },
    { "include": "#assignments" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.ikemen-cns",
          "match": ";.*$"
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "name": "meta.section.ikemen-cns",
          "match": "^\\s*(\\[)([^\\]\\r\\n]+)(\\])",
          "captures": {
            "1": { "name": "punctuation.definition.section.ikemen-cns" },
            "2": { "name": "entity.name.section.ikemen-cns" },
            "3": { "name": "punctuation.definition.section.ikemen-cns" }
          }
        }
      ]
    },
    "commands": {
      "patterns": [
        {
          "name": "meta.command.sequence.ikemen-cns",
          "begin": "^\\s*(command)(\\s*=\\s*)",
          "beginCaptures": {
            "1": { "name": "variable.other.constant.ikemen-cns" },
            "2": { "name": "keyword.operator.assignment.ikemen-cns" }
          },
          "end": "$",
          "patterns": [
            { "include": "#comments" },
            { "name": "keyword.operator.command.modifier.ikemen-cns", "match": "(?:~\\d*|[/>$*])" },
            { "name": "constant.language.command.direction.ikemen-cns", "match": "(?<![A-Za-z])(?:DB|DF|UB|UF|DL|DR|UL|UR|[BDFULRN])(?![A-Za-z])" },
            { "name": "variable.language.command.button.ikemen-cns", "match": "(?<![A-Za-z])[xyzabcswm](?![A-Za-z])" },
            { "name": "keyword.operator.command.relation.ikemen-cns", "match": "[,|+]" }
          ]
        }
      ]
    },
    "assignments": {
      "patterns": [
        {
          "name": "meta.assignment.ikemen-cns",
          "begin": "^\\s*([A-Za-z_][A-Za-z0-9_.]*)(\\s*=\\s*)",
          "beginCaptures": {
            "1": { "name": "variable.other.constant.ikemen-cns" },
            "2": { "name": "keyword.operator.assignment.ikemen-cns" }
          },
          "end": "$",
          "patterns": [
            { "include": "#comments" },
            {
              "name": "string.quoted.double.ikemen-cns",
              "begin": "\"",
              "end": "\""
            },
            {
              "name": "constant.numeric.ikemen-cns",
              "match": "(?<![A-Za-z0-9_.])[-+]?(?:0[xX][0-9A-Fa-f]+|(?:\\d+\\.?(?:\\d*)?|\\.\\d+)(?:[eE][-+]?\\d+)?)(?![A-Za-z0-9_.])"
            }
          ]
        }
      ]
    }
  }
}
