{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "IKEMEN Constants",
  "scopeName": "source.ikemen-cns",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#sections"
    },
    {
      "include": "#commands"
    },
    {
      "include": "#assignments"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.ikemen-cns",
          "match": ";.*$"
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "name": "meta.section.ikemen-cns",
          "match": "^\\s*(\\[)([^\\]\\r\\n]+)(\\])",
          "captures": {
            "1": {
              "name": "punctuation.definition.section.ikemen-cns"
            },
            "2": {
              "name": "entity.name.section.ikemen-cns"
            },
            "3": {
              "name": "punctuation.definition.section.ikemen-cns"
            }
          }
        }
      ]
    },
    "commands": {
      "patterns": [
        {
          "name": "meta.command.sequence.ikemen-cns",
          "begin": "^\\s*(command)(\\s*=\\s*)",
          "beginCaptures": {
            "1": {
              "name": "variable.other.constant.ikemen-cns"
            },
            "2": {
              "name": "keyword.operator.assignment.ikemen-cns"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "name": "keyword.operator.command.modifier.ikemen-cns",
              "match": "(?:~\\d*|[/>$*])"
            },
            {
              "name": "constant.language.command.direction.ikemen-cns",
              "match": "(?<![A-Za-z])(?:DB|DF|UB|UF|DL|DR|UL|UR|[BDFULRN])(?![A-Za-z])"
            },
            {
              "name": "variable.language.command.button.ikemen-cns",
              "match": "(?<![A-Za-z])[xyzabcswdm](?![A-Za-z])"
            },
            {
              "name": "keyword.operator.command.relation.ikemen-cns",
              "match": "[,|+]"
            }
          ]
        }
      ]
    },
    "assignments": {
      "patterns": [
        {
          "name": "meta.trigger.ikemen-cns",
          "begin": "(?i)^\\s*(trigger(?:all|\\d+))(\\s*=\\s*)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.trigger.ikemen-cns"
            },
            "2": {
              "name": "keyword.operator.assignment.ikemen-cns"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "name": "string.quoted.double.ikemen-cns",
              "begin": "\"",
              "end": "\""
            },
            {
              "name": "constant.numeric.ikemen-cns",
              "match": "(?<![A-Za-z0-9_.])[-+]?(?:0[xX][0-9A-Fa-f]+|(?:\\d+\\.?(?:\\d*)?|\\.\\d+)(?:[eE][-+]?\\d+)?)(?![A-Za-z0-9_.])"
            },
            {
              "include": "#expression"
            }
          ]
        },
        {
          "name": "meta.type.ikemen-cns",
          "match": "(?i)^\\s*(type)(\\s*=\\s*)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "variable.other.constant.ikemen-cns"
            },
            "2": {
              "name": "keyword.operator.assignment.ikemen-cns"
            },
            "3": {
              "name": "support.type.controller.ikemen-cns"
            }
          }
        },
        {
          "name": "meta.assignment.ikemen-cns",
          "begin": "^\\s*([A-Za-z_][A-Za-z0-9_.]*)(\\s*=\\s*)",
          "beginCaptures": {
            "1": {
              "name": "variable.other.constant.ikemen-cns"
            },
            "2": {
              "name": "keyword.operator.assignment.ikemen-cns"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "name": "string.quoted.double.ikemen-cns",
              "begin": "\"",
              "end": "\""
            },
            {
              "name": "constant.numeric.ikemen-cns",
              "match": "(?<![A-Za-z0-9_.])[-+]?(?:0[xX][0-9A-Fa-f]+|(?:\\d+\\.?(?:\\d*)?|\\.\\d+)(?:[eE][-+]?\\d+)?)(?![A-Za-z0-9_.])"
            },
            {
              "include": "#expression"
            }
          ]
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "name": "variable.language.redirect.ikemen-cns",
          "match": "(?i)\\b(?:parent|root|helper|target|partner|enemy|enemynear|playerid|playerindex|helperindex|stateowner)\\b(?=\\s*(?:\\(|,))"
        },
        {
          "name": "support.function.variable.ikemen-cns",
          "match": "(?i)\\b(?:var|fvar|sysvar|sysfvar)\\b(?=\\s*\\()"
        },
        {
          "name": "keyword.control.conditional.ikemen-cns",
          "match": "(?i)\\b(?:ifelse|cond)\\b(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.trigger.ikemen-cns",
          "match": "\\b[A-Za-z_][A-Za-z0-9_.]*(?=\\s*\\()"
        },
        {
          "name": "keyword.operator.logical.ikemen-cns",
          "match": "&&|\\|\\||\\^\\^|!(?!=)"
        },
        {
          "name": "keyword.operator.comparison.ikemen-cns",
          "match": ":=|!=|<=|>=|=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.ikemen-cns",
          "match": "\\*\\*|[-+*/%&|^~]"
        }
      ]
    }
  }
}
